# Copy this file to .env and fill in real values before running.
# Once copied, this tells Compose to load that private file rather than this
# checked-in example. Without a .env file, Compose safely falls back here.
DISCOVERY_ENV_FILE=.env

# --- database ---
DATABASE_URL=postgresql+asyncpg://discovery:discovery@db:5432/discovery
# Used by Alembic (sync driver) for migrations only:
DATABASE_URL_SYNC=postgresql+psycopg2://discovery:discovery@db:5432/discovery

# --- api auth ---
# Static API key checked with hmac.compare_digest. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DISCOVERY_API_KEY=changeme-generate-a-real-key
# Must be different from DISCOVERY_API_KEY; only this key can reset the global switch.
DISCOVERY_ADMIN_API_KEY=changeme-generate-a-distinct-admin-key
# AES-256-GCM key for expiring authenticated-scan headers. Generate with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
DISCOVERY_CREDENTIAL_ENCRYPTION_KEY=
SCAN_CREDENTIAL_TTL_SECONDS=7200

# --- web console auth (API keys remain server-side) ---
CONSOLE_PASSWORD=change-me-generate-a-console-password
CONSOLE_SESSION_SECRET=change-me-generate-at-least-32-random-bytes
# Enable only when the console is served over HTTPS.
CONSOLE_SECURE_COOKIES=false

# --- scope (fail-closed: if this is empty, NOTHING is in scope) ---
# Comma-separated. Supports exact host:port, *.wildcard.example.com, and CIDR blocks.
# Example: "example.com,*.staging.example.com,10.20.30.0/24"
# Empty = fail-closed (nothing in scope). Add only targets you are authorised to
# test. For a Docker target, reach it over the shared Compose bridge by container
# name; the host-gateway / host-published path is unreliable on Docker Desktop +
# WSL2 and breaks Validation preflight.
SCOPE_ALLOWLIST=

# --- offline / demo-safe mode ---
# When true: S1 (subfinder passive sources), S3 (live cpe-guesser/NVD lookups),
# S4 (Katana's `dit` model download), and S6 (EPSS/NVD) are all skipped/best-effort.
OFFLINE_MODE=false

# --- external enrichment ---
# Free, instant, no-cost key from https://nvd.nist.gov/developers/request-an-api-key
# Without it you get 5 req/30s; with it, 50 req/30s.
NVD_API_KEY=

# --- orchestration tuning (see IMPLEMENTATION_SPEC_v4.md §8 for rationale) ---
HEARTBEAT_INTERVAL_SECONDS=15
STALE_JOB_THRESHOLD_SECONDS=300
MAX_JOB_ATTEMPTS=3
KILLSWITCH_POLL_INTERVAL_SECONDS=5
LISTEN_NOTIFY_SELFTEST_TIMEOUT_SECONDS=5
POLL_INTERVAL_SECONDS=1.5

# --- tool binary paths (defaults assume the Docker image installs them on PATH) ---
SUBFINDER_BIN=subfinder
DNSX_BIN=dnsx
NAABU_BIN=naabu
HTTPX_BIN=httpx
KATANA_BIN=katana
NUCLEI_BIN=nuclei
NUCLEI_TEMPLATES_PATH=/opt/nuclei-templates
# Parameter-fuzzing corpus (~250 templates). Scoping the DAST pass to this
# subtree keeps it to templates that actually mutate inputs; pointing it at the
# full root instead loads thousands of non-fuzzing signature templates.
NUCLEI_DAST_TEMPLATES_PATH=/opt/nuclei-templates/dast
NMAP_BIN=nmap

# --- bounded crawler / parameter discovery ---
CRAWL_DEPTH_FAST=5
CRAWL_DEPTH_DEEP=8
CRAWL_MAX_PAGES_FAST=250
CRAWL_MAX_PAGES_DEEP=1000
CRAWL_MAX_JAVASCRIPT_FILES=100
CRAWL_REQUEST_TIMEOUT_SECONDS=12
# Parameter hypotheses handed to Validation. Candidates collapse on
# (path, parameter, class, auth context), so this caps distinct attack surface
# rather than raw crawled URLs.
DISCOVERY_MAX_PARAMETER_CANDIDATES=400

# --- S5 scan sizing (decides whether a scan finishes or dies on its deadline) ---
# Signature templates match on path/response, so they scan distinct paths; DAST
# fuzzing scans one representative per parameter shape. Both sets are capped so
# one stage can never run unbounded.
DISCOVERY_MAX_SIGNATURE_TARGETS=150
DISCOVERY_MAX_DAST_SEED_URLS=80
# Per-pass Nuclei deadline. A pass that overruns is killed but KEEPS every
# finding it had already streamed.
NUCLEI_TIMEOUT_FAST_SECONDS=300
NUCLEI_TIMEOUT_DEEP_SECONDS=600
# Request pacing against an authorized target. Lower these if the target is
# fragile; S3's WAF signal overrides both with a slow, polite floor (10/2).
NUCLEI_RATE_LIMIT=120
NUCLEI_CONCURRENCY=25

# --- evidence storage ---
EVIDENCE_STORE_PATH=/data/evidence
VALIDATION_REQUEST_TIMEOUT_SECONDS=12
VALIDATION_MAX_RESPONSE_BYTES=1000000
VALIDATION_MAX_ATTEMPTS=3
VALIDATION_REQUESTS_PER_SECOND=3

# --- contract import path ---
# Adjust to wherever your actual Module 2/3 package lives. See app/contract_adapter.py.
GRAPH_CONTRACT_MODULE=app.graph.contract
GRAPH_MODEL_MODULE=app.graph.model
